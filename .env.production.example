# 운영 환경변수 예시 — 실제 값은 절대 이 파일에 넣지 않는다.
# 실제 파일은 WAS EC2 의 /app/CHANGEME_SLUG/.env.production 에 mode 600 으로 직접 만든다.
# 생성 절차는 DEPLOY.md 의 ".env.production 만들기" 참고.

# ── 애플리케이션 ──────────────────────────────────────────────────────
NODE_ENV=production
# 컨테이너 내부 포트. docker-compose.yml 의 컨테이너쪽 포트와 반드시 일치.
PORT=3000

# 관리자 페이지(/admin.html) 및 /api/admin/* Basic 인증 비밀번호.
# EC2 에서 `openssl rand -base64 32` 로 생성하고 로그에 출력하지 않는다.
ADMIN_PASSWORD=CHANGEME_SECRET

# ── PostgreSQL / RDS ──────────────────────────────────────────────────
# 개별 필드 방식을 권장한다. 비밀번호 퍼센트 인코딩 실수를 피할 수 있다.
DB_HOST=CHANGEME_RDS_PRIVATE_ENDPOINT
DB_PORT=5432
DB_NAME=CHANGEME_DATABASE_NAME
DB_USER=CHANGEME_DATABASE_USER
DB_PASSWORD=CHANGEME_SECRET
# require = 암호화만. verify-full = 서버 인증서까지 검증(DB_SSL_CA_PATH 필요).
DB_SSLMODE=require
# verify-full 을 쓸 때만 설정. RDS CA 번들을 이미지 밖 경로에 두고 마운트한다.
# DB_SSL_CA_PATH=/app/certs/rds-ca-bundle.pem

# DB_HOST 가 비어 있을 때만 아래 URL 이 사용된다. 둘 중 하나만 채운다.
# 비밀번호에 @ : / ? # 등이 있으면 반드시 퍼센트 인코딩할 것.
# DATABASE_URL=postgresql://CHANGEME_USER:CHANGEME_URL_ENCODED_PASSWORD@CHANGEME_RDS_PRIVATE_ENDPOINT:5432/CHANGEME_DATABASE?sslmode=require
