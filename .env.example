# 로컬 개발용 예시. 실제 값은 .env 에 넣고 커밋하지 않는다.

PORT=3000
ADMIN_PASSWORD=local-admin-password

# 개별 필드 방식 (권장)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blood_donation
DB_USER=postgres
DB_PASSWORD=postgres
# 로컬 Docker Postgres는 TLS를 쓰지 않으므로 disable
DB_SSLMODE=disable

# URL 방식 (DB_HOST 가 없을 때만 사용됨)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blood_donation
